  },
  "files": ["bin", "lib", "public", "kit", "examples", "LICENSE", "README.md"],
  "keywords": ["claude-code", "agents", "ralph-loop", "task-graph", "dashboard", "harness-engineering"],
  "engines": { "node": ">=20" },
